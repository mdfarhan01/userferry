msgid "Best for"
msgstr ""

#: templates/admin/docs.php:218
msgid "Notes"
msgstr ""

#: templates/admin/docs.php:220
msgid "Excel, Google Sheets, mailing tools, imports"
msgstr ""

#: templates/admin/docs.php:220
msgid "Separator and UTF-8 marker are configurable in Settings."
msgstr ""

#: templates/admin/docs.php:221
msgid "Sharing a ready-to-read spreadsheet"
msgstr ""

#: templates/admin/docs.php:221
msgid "Styled header row, frozen headings, filter buttons, numeric IDs stored as numbers."
